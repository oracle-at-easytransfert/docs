{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "willow",
  "name": "Easy Transfert",
  "colors": {
    "primary": "#1d60d5",
    "light": "#3b82f6",
    "dark": "#0f4c9e"
  },
  "appearance": {
    "default": "system",
    "strict": false,
    "background": {
      "decoration": "gradient"
    }
  },
  "fonts": {
    "heading": {
      "family": "Inter",
      "weight": 600
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "favicon": "/images/téléchargement.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Accueil",
        "anchors": [
          {
            "anchor": "C'est quoi le Mobile Money ?"
          }
        ]
      },
      {
        "tab": "Accueil",
        "pages": [
          "index-copied-1"
        ]
      },
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "INTRODUCTION",
            "pages": [
              "documentation/introduction/presentation-api"
            ]
          },
          {
            "group": "DÉMARRAGE RAPIDE",
            "pages": [
              "documentation/demarrage-rapide/vue-ensemble-flux",
              "documentation/demarrage-rapide/preparation-environnement",
              "documentation/demarrage-rapide/initier-transaction",
              "documentation/demarrage-rapide/reception-ipn",
              "documentation/demarrage-rapide/verifier-statut",
              "documentation/demarrage-rapide/checklist-pre-production"
            ]
          },
          {
            "group": "AUTHENTIFICATION & SÉCURITÉ",
            "pages": [
              "documentation/authentification-securite/authentification",
              "documentation/authentification-securite/securite"
            ]
          },
          {
            "group": "GESTION DES ERREURS",
            "pages": [
              "documentation/gestion-des-erreurs",
              "documentation/gestion-erreurs/codes-http"
            ]
          },
          {
            "group": "LIMITATIONS & RÈGLES MÉTIER",
            "pages": [
              "documentation/limitations-regles-metier/rate-limiting",
              "documentation/limitations-regles-metier/bonnes-pratiques"
            ]
          },
          {
            "group": "ANNEXES",
            "pages": [
              "documentation/annexes/glossaire-variables-testeur-api",
              "documentation/annexes/support-disponibilite",
              "documentation/annexes/tarification-conditions-financieres",
              "documentation/annexes/kyc-conformite",
              "documentation/annexes/comptes-business",
              "documentation/annexes/gestion-plaintes",
              "documentation/dictionnaire"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "TRANSACTION",
            "pages": [
              "api-reference/transaction/verifier-le-status",
              "api-reference/endpoint/transaction"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/téléchargement.png",
    "dark": "/images/téléchargement.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hi@mintlify.com"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  },
  "description": "Just Easy",
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": true
    }
  },
  "search": {
    "prompt": "Vous recherchez quelque chose que vous ne trouvez pas ?"
  }
}